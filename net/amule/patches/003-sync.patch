-		}
-	} else {
-		if (WIFEXITED(*status)) {
-			*msg << wxT("Child has terminated with status code `") <<
-				WEXITSTATUS(*status) <<
-				wxT("'.");
-		} else if (WIFSIGNALED(*status)) {
-			*msg << wxT("Child was killed by signal `") <<
-				WTERMSIG(*status) <<
-				wxT("'.");
-			if (WCOREDUMP(*status)) {
