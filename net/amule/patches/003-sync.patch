+void CUploadDiskIOThread::EndThread()
+{
+	{
+		wxMutexLocker lock(m_mutex);
+		m_bRun = false;
+		m_condition.Signal();
+	}
+	Wait();	// join — replaces m_eventThreadEnded->Lock()
+}
