+CUploadDiskIOThread::CUploadDiskIOThread()
+	: wxThread(wxTHREAD_JOINABLE)
+	, m_condition(m_mutex)
+{
+	m_bRun = false;
+	m_bSignalThrottler = false;
+	m_bNewBlocksPending = false;
+	m_bSocketNeedsPending = false;
+
+	wxMutexLocker lock(m_mutex);
+	if (Create() == wxTHREAD_NO_ERROR) {
+		Run();
+	}
