From 65f80d9537cb270af86d9fa49b89849fda5fe155 Mon Sep 17 00:00:00 2001
From: Alexandru Ardelean <alex@shruggie.ro>
Date: Sat, 16 May 2026 15:55:44 +0300
Subject: [PATCH] udev: implement hwdb USB ID lookup from usb.ids

Replace the four stub udev_hwdb_*() functions with a working
implementation that looks up vendor and product names from a
usb.ids database file (e.g. provided by the hwdata package).

udev_hwdb_new() opens the file to verify it exists; subsequent
calls to udev_hwdb_get_properties_list_entry() parse the file for
USB modalias strings of the form "usb:vVVVVpPPPP" (product lookup)
or "usb:vVVVV" (vendor lookup), and populate the entry list with
ID_MODEL_FROM_DATABASE or ID_VENDOR_FROM_DATABASE properties.

The path to the usb.ids file defaults to /usr/share/hwdata/usb.ids
but is configurable at build time.
It can be configured at build-time and also passed via env-var
at run-time.

Signed-off-by: Alexandru Ardelean <alex@shruggie.ro>
---
 Makefile |   2 +
 udev.c   | 154 ++++++++++++++++++++++++++++++++++++++++++++++++++++---
 2 files changed, 149 insertions(+), 7 deletions(-)

diff --git a/Makefile b/Makefile
index 1fc5a1f..9aa1c5b 100644
--- a/Makefile
+++ b/Makefile
@@ -5,7 +5,9 @@ PREFIX = /usr/local
 LIBDIR = ${PREFIX}/lib
 INCLUDEDIR = ${PREFIX}/include
 PKGCONFIGDIR = ${LIBDIR}/pkgconfig
+USB_IDS_PATH = /usr/share/hwdata/usb.ids
 XCFLAGS = ${CPPFLAGS} ${CFLAGS} -std=c99 -fPIC -D_XOPEN_SOURCE=700 \
+		  -DUSB_IDS_PATH=\"${USB_IDS_PATH}\" \
 		  -Wall -Wextra -Wpedantic -Wmissing-prototypes -Wstrict-prototypes \
 		  -Wno-unused-parameter
 XLDFLAGS = ${LDFLAGS} -shared -Wl,-soname,libudev.so.1
diff --git a/udev.c b/udev.c
index ab5d33a..10778db 100644
--- a/udev.c
+++ b/udev.c
@@ -15,9 +15,13 @@
  * OR IN CONNECTION WITH THE USE OR PERFORMANCE OF THIS SOFTWARE.
  */
 
+#include <stdio.h>
+#include <stdint.h>
 #include <stdlib.h>
+#include <string.h>
 
 #include "udev.h"
+#include "udev_list.h"
 
 struct udev {
     int refcount;
@@ -76,22 +80,158 @@ int udev_get_log_priority(struct udev *udev)
     return 0;
 }
 
-/* XXX NOT IMPLEMENTED */ struct udev_hwdb *udev_hwdb_new(struct udev *udev)
+#ifndef USB_IDS_PATH
+#define USB_IDS_PATH "/usr/share/hwdata/usb.ids"
+#endif
+
+struct udev_hwdb {
+    struct udev_list_entry head;
+    int refcount;
+};
+
+static int usb_ids_lookup_vendor(uint16_t vendorid, char *buf, size_t buflen)
 {
-    return NULL;
+    char *line, *name;
+    const char *path;
+    unsigned int id;
+    size_t len;
+    FILE *f;
+
+    /* heap-allocated to avoid a 512-byte stack frame; libudev-zero may
+     * be called from small thread stacks (musl default ~128 KiB) */
+    line = malloc(512);
+    if (!line)
+        return 0;
+    path = getenv("USB_IDS_PATH");
+    f = fopen(path ? path : USB_IDS_PATH, "r");
+    if (!f) {
+        free(line);
+        return 0;
+    }
+    while (fgets(line, 512, f)) {
+        if (line[0] == '#' || line[0] == '\t' || line[0] == '\n')
+            continue;
+        if (sscanf(line, "%04x", &id) != 1 || id != vendorid)
+            continue;
+        name = strchr(line, ' ');
+        if (name) {
+            while (*name == ' ')
+                name++;
+            len = strlen(name);
+            while (len > 0 && (name[len - 1] == '\n' || name[len - 1] == '\r'))
+                name[--len] = '\0';
+            snprintf(buf, buflen, "%s", name);
+        }
+        break;
+    }
+    fclose(f);
+    free(line);
+    return buf[0] != '\0';
 }
 
-/* XXX NOT IMPLEMENTED */ struct udev_hwdb *udev_hwdb_ref(struct udev_hwdb *hwdb)
+static int usb_ids_lookup_product(uint16_t vendorid, uint16_t productid, char *buf, size_t buflen)
 {
-    return NULL;
+    int in_vendor = 0;
+    char *line, *name;
+    const char *path;
+    unsigned int id;
+    size_t len;
+    FILE *f;
+
+    line = malloc(512);
+    if (!line)
+        return 0;
+    path = getenv("USB_IDS_PATH");
+    f = fopen(path ? path : USB_IDS_PATH, "r");
+    if (!f) {
+        free(line);
+        return 0;
+    }
+    while (fgets(line, 512, f)) {
+        if (line[0] == '#' || line[0] == '\n')
+            continue;
+        if (in_vendor) {
+            if (line[0] != '\t')
+                break;
+            if (line[1] == '\t')
+                continue;
+            if (sscanf(line + 1, "%04x", &id) != 1 || id != productid)
+                continue;
+            name = strchr(line + 1, ' ');
+            if (name) {
+                while (*name == ' ')
+                    name++;
+                len = strlen(name);
+                while (len > 0 && (name[len - 1] == '\n' || name[len - 1] == '\r'))
+                    name[--len] = '\0';
+                snprintf(buf, buflen, "%s", name);
+            }
+            break;
+        }
+        if (line[0] == '\t')
+            continue;
+        if (sscanf(line, "%04x", &id) != 1 || id != vendorid)
+            continue;
+        in_vendor = 1;
+    }
+    fclose(f);
+    free(line);
+    return buf[0] != '\0';
 }
 
-/* XXX NOT IMPLEMENTED */ struct udev_hwdb *udev_hwdb_unref(struct udev_hwdb *hwdb)
+struct udev_hwdb *udev_hwdb_new(struct udev *udev)
 {
-    return NULL;
+    struct udev_hwdb *hwdb;
+    const char *path;
+    FILE *f;
+
+    path = getenv("USB_IDS_PATH");
+    f = fopen(path ? path : USB_IDS_PATH, "r");
+    if (!f)
+        return NULL;
+    fclose(f);
+    hwdb = calloc(1, sizeof(*hwdb));
+    if (!hwdb)
+        return NULL;
+    hwdb->refcount = 1;
+    return hwdb;
 }
 
-/* XXX NOT IMPLEMENTED */ struct udev_list_entry *udev_hwdb_get_properties_list_entry(struct udev_hwdb *hwdb, const char *modalias, unsigned int flags)
+struct udev_hwdb *udev_hwdb_ref(struct udev_hwdb *hwdb)
 {
+    if (!hwdb)
+        return NULL;
+    hwdb->refcount++;
+    return hwdb;
+}
+
+struct udev_hwdb *udev_hwdb_unref(struct udev_hwdb *hwdb)
+{
+    if (!hwdb)
+        return NULL;
+    if (--hwdb->refcount > 0)
+        return NULL;
+    udev_list_entry_free_all(&hwdb->head);
+    free(hwdb);
     return NULL;
 }
+
+struct udev_list_entry *udev_hwdb_get_properties_list_entry(struct udev_hwdb *hwdb, const char *modalias, unsigned int flags)
+{
+    unsigned int vendorid, productid;
+    char name[64];
+
+    if (!hwdb || !modalias)
+        return NULL;
+    udev_list_entry_free_all(&hwdb->head);
+    hwdb->head.next = NULL;
+    name[0] = '\0';
+    if (sscanf(modalias, "usb:v%4xp%4x", &vendorid, &productid) == 2) {
+        if (usb_ids_lookup_product((uint16_t)vendorid, (uint16_t)productid, name, sizeof(name)))
+            udev_list_entry_add(&hwdb->head, "ID_MODEL_FROM_DATABASE", name, 0);
+    } else if (sscanf(modalias, "usb:v%4x", &vendorid) == 1) {
+        if (usb_ids_lookup_vendor((uint16_t)vendorid, name, sizeof(name)))
+            udev_list_entry_add(&hwdb->head, "ID_VENDOR_FROM_DATABASE", name, 0);
+    }
+    return hwdb->head.next;
+}
-- 
2.43.0
